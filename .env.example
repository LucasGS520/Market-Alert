# ── Banco de Dados ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://market:market_pass@postgres:5432/market_alert
# URL sincrona usada pelo Alembic CLI dentro do Docker Compose
DATABASE_SYNC_URL=postgresql+psycopg2://market:market_pass@postgres:5432/market_alert

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Scraper ─────────────────────────────────────────────────────────────────
SCRAPER_URL=http://market_scraper:8001
SCRAPER_TIMEOUT_SECONDS=270
PLAYWRIGHT_ENABLED=true
REQUEST_TIMEOUT_SECONDS=15
PLAYWRIGHT_TIMEOUT_MS=60000
MAX_TOTAL_REQUEST_SECONDS=240
SESSION_STATE_DIR=.session_state

# ── Notificações ─────────────────────────────────────────────────────────────
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=market_alert

# ── Regras de Negócio ────────────────────────────────────────────────────────
NOTIFICATION_DELTA_PERCENT=1.0
NOTIFICATION_COOLDOWN_MINUTES=10
# Cooldown aplicado ao domínio após CAPTCHA/bloqueio (segundos, padrão 300 = 5 min)
DOMAIN_CAPTCHA_COOLDOWN_SECONDS=300
# Cooldown curto entre coletas do mesmo domínio; em Docker conservador a fila principal é serial.
DOMAIN_RATE_LIMIT_TTL_SECONDS=2

# ── Agendamento Adaptativo ───────────────────────────────────────────────────
MIN_CHECK_INTERVAL_MINUTES=30
MAX_CHECK_INTERVAL_MINUTES=240
CONSECUTIVE_UNCHANGED_THRESHOLD=3

# ── Retry e Backoff de Coleta ────────────────────────────────────────────────
# Delay base de retry após erro (minutos); multiplicado pelo número de tentativas
COLLECTION_RETRY_BASE_DELAY_MINUTES=5
# Limite máximo de delay entre retries (minutos)
COLLECTION_RETRY_MAX_DELAY_MINUTES=60
# Timeout máximo de uma rodada coordenada (produto + concorrentes), em segundos
COLLECTION_RUN_TIMEOUT_SECONDS=300

# ── Servidor ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
