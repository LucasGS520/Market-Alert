# .gitignore - padrões para projeto Python/Docker/IDE
# Gerado pelo assistente - inclui ambientes virtuais, caches, chaves e artefatos de build

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
share/python-wheels/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.venv

# Environment files
.env
.env.*
!.env.example

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/

# Type check / caches
.mypy_cache/
.dmypy.json
dmypy.json

# Logs and local DBs
*.log
logs/
*.sqlite3
*.db
*.db-journal

# Celery
celerybeat-schedule
celerybeat.pid

# Jupyter
.ipynb_checkpoints

# Sphinx docs
docs/_build/

# Editor / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Docker / Compose overrides and local files
docker-compose.override.yml
docker-compose.*.yml

# Secrets, keys and certificates
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
id_rsa
id_rsa.pub
.ssh/
credentials.json

# Playwright / browser caches
.playwright/
.cache/

# Misc
*.swp
*~
*.tmp
*.bak
*.orig

# Node (se houver)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Poetry / virtualenv in project
.venv/
dist/
.mypy_cache/

# Alembic / migration outputs
alembic/versions/*.pyc

# Market scraper runtime artifacts
market_scraper/.venv/
market_scraper/.cache/

# Documento Auxiliares de Desenvolvimento
.auxiliar/
.auxiliar